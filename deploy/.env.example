# Copy this file to deploy/.env and replace every example or REPLACE value.
# Keep values on one line in KEY=value form. Do not commit deploy/.env.

COMPOSE_PROJECT_NAME=threadhub
TZ=Asia/Seoul

# Public service identity
THREADHUB_DOMAIN=threadhub.example.com
LETSENCRYPT_EMAIL=admin@example.com

# Host paths and loopback binding
THREADHUB_DATA_ROOT=/srv/threadhub
MATTERMOST_BIND_ADDRESS=127.0.0.1
MATTERMOST_BIND_PORT=8065

# PostgreSQL
POSTGRES_USER=mmuser
# Use 64 hexadecimal characters: openssl rand -hex 32
POSTGRES_PASSWORD=REPLACE_WITH_64_HEX_CHARACTER_PASSWORD
POSTGRES_DB=mattermost

# OCI Email Delivery. See deploy/docs/oci-email-delivery.md before replacing.
# Example endpoint: smtp.email.ap-seoul-1.oci.oraclecloud.com
SMTP_SERVER=smtp.email.REGION.oci.oraclecloud.com
SMTP_PORT=587
SMTP_USERNAME=REPLACE_WITH_OCI_SMTP_USERNAME
SMTP_PASSWORD=REPLACE_WITH_OCI_SMTP_PASSWORD
SMTP_FROM_ADDRESS=no-reply@example.com
SMTP_REPLY_TO_ADDRESS=support@example.com
SMTP_FEEDBACK_NAME=ThreadHub

# Immediate channel email notifier target state. Runtime delivery remains
# disabled until the installer completes SMTP acceptance and activation gates.
NOTIFIER_ENABLED=true
NOTIFIER_MODE=all_channels
NOTIFIER_CHANNEL_IDS=
NOTIFIER_HMAC_SECRET=REPLACE_WITH_64_HEX_CHARACTER_HMAC_SECRET
NOTIFIER_RATE_PER_MINUTE=10
# generic keeps every project detail out of email. project_team_channel adds
# the domain, Team display name, channel display name, and post/reply type.
NOTIFIER_CONTENT_MODE=project_team_channel
