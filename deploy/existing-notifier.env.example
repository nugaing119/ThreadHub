# Existing Mattermost notifier adoption configuration.
# Copy to deploy/existing-notifier.env, replace every example value, and set mode 0600.
THN_COMPOSE_PROJECT_DIR=/opt/mattermost
THN_COMPOSE_FILE=/opt/mattermost/docker-compose.yml
THN_COMPOSE_ENV_FILE=/opt/mattermost/.env
THN_MATTERMOST_SERVICE=mattermost
THN_MATTERMOST_PLUGINS_ROOT=/srv/mattermost/plugins
THN_MATTERMOST_DATA_ROOT=/srv/mattermost/data
THN_DATA_ROOT=/srv/threadhub-notifier
THN_DOMAIN=mattermost.example.com
THN_SMTP_SERVER=smtp.email.ap-singapore-1.oci.oraclecloud.com
THN_SMTP_PORT=587
THN_SMTP_USERNAME=replace-with-project-smtp-username
THN_SMTP_PASSWORD=replace-with-project-smtp-password
THN_SMTP_FROM_ADDRESS=no-reply@example.com
THN_SMTP_REPLY_TO_ADDRESS=admin@example.com
THN_SMTP_FEEDBACK_NAME=ThreadHub
THN_HMAC_SECRET=replace-with-64-hexadecimal-characters
THN_RATE_PER_MINUTE=10
