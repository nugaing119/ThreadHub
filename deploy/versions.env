# ThreadHub immediate channel email notifier release.
NOTIFIER_VERSION=0.2.1
NOTIFIER_PLUGIN_ID=com.threadhub.channel-email-notifier
# SHA-256 of the UTF-8 compact JSON array [.history[].created_by] plus exactly one LF
# from the Docker BuildKit-exported linux/amd64 Mailer image config bound to its
# immutable image ID. Builds from a different container engine must fail closed.
NOTIFIER_MAILER_CREATED_BY_HISTORY_SHA256=dd3c3ef0e8b6b4d52bb2ee833d83f409fb4485875d3069ec5a75976c48dff82c
