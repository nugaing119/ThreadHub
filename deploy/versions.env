# ThreadHub runtime versions for Ubuntu 24.04 LTS on linux/amd64.
# Update only through the documented change and validation process.

MATTERMOST_IMAGE_REPOSITORY=mattermost/mattermost-team-edition
MATTERMOST_IMAGE_TAG=11.10.1
# linux/amd64 runtime manifest digest
MATTERMOST_IMAGE_DIGEST=sha256:12f18e9f6ad2a9c29a95393f337aa2ab0700517a55470cd943a759f5392a017f
# Multi-platform index digest retained for provenance
MATTERMOST_IMAGE_INDEX_DIGEST=sha256:8285b96eb412d89dd308e4c1ad9cc7f1a9dc9edcd798167b55bc35f1c7ee69d1

POSTGRES_IMAGE_REPOSITORY=postgres
