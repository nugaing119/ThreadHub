log_format threadhub_safe '$remote_addr - $remote_user [$time_local] '
                          '"$request_method $uri $server_protocol" '
                          '$status $body_bytes_sent "$http_user_agent"';

server {
    listen 80;
    listen [::]:80;
    server_name __THREADHUB_DOMAIN__;

    server_tokens off;
    access_log /var/log/nginx/threadhub.access.log threadhub_safe;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 301 https://__THREADHUB_DOMAIN__$request_uri;
    }
}
